{
  "name": "davis-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "vitest --project unit-server",
    "test:client": "vitest --project unit-client",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,mdx,css,yaml,yml}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,mdx,css,yaml,yml}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@react-email/components": "^1.0.9",
    "@react-email/render": "^2.0.4",
    "@react-pdf/renderer": "^4.5.1",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/blob": "^2.6.1",
    "duration-fns": "^3.0.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.563.0",
    "marked": "^18.0.7",
    "next": "^16.4.0",
    "next-intl": "^4.8.3",
    "next-sanity": "^13.3.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.9.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.2",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.5",
    "jsdom": "^30.1.2",
    "lint-staged": "^15.2.9",
    "postcss": "^8",
    "prettier": "3.2.5",
    "sass": "^1.77.2",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "prettier --write",
      "eslint"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
